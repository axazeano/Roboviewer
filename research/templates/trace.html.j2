{# What one run did with its context. Rendered from the log, not from the run
   results, so an interrupted run still has a page. #}
{% extends "_layout.html.j2" %}
{% import "_trace_agent.html.j2" as parts %}

{% block title %}Trace {{ meta.branch }} → {{ meta.target }}{% endblock %}

{% block styles %}
{% include "_styles.css.j2" %}
{% include "_trace.css.j2" %}
{% endblock %}

{% block content %}
<h1>What this run did</h1>

<dl class="meta">
<dt>Run</dt><dd><code>{{ meta.run_id }}</code>{% if meta.started_at %} · started {{ meta.started_at }}{% endif %}</dd>
<dt>Branch</dt><dd>{{ meta.branch }} → {{ meta.target }}</dd>
<dt>Merge base</dt><dd><code>{{ meta.base_sha[:12] }}</code> · HEAD <code>{{ meta.head_sha[:12] }}</code></dd>
<dt>Model</dt><dd><code>{{ meta.model }}</code></dd>
</dl>

<ul class="tally">
<li>{{ stats.agents }} agents</li>
<li>{{ stats.turns }} turns</li>
<li>{{ stats.reads }} reads</li>
<li>{{ stats.searches }} searches</li>
<li>{{ stats.total_tokens | thousands }} tokens</li>
</ul>

{% if stats.unfinished %}
<p class="unfinished">{{ stats.unfinished }} of the agents never reported an end. The log stops where the run
stopped, and what is below is what had already happened.</p>
{% endif %}

<h2>Changed files</h2>
<p class="lede">An agent opened {{ stats.files_opened }} of {{ stats.files_changed }}. The rest were seen only in the
prompt, which is not the same as being read — and not the same as being clean.</p>
<ul class="files">
{% for file in files %}
<li class="{{ 'opened' if file.readers else 'untouched' }}">
<code>{{ file.file }}</code>
<span class="by">{% if file.readers %}opened by {{ file.readers }}{% else %}never opened{% endif %}</span>
</li>
{% endfor %}
</ul>

{% if elsewhere %}
<details>
<summary>Opened outside the change ({{ elsewhere | length }})</summary>
<ul>
{% for path in elsewhere %}
<li><code>{{ path }}</code></li>
{% endfor %}
</ul>
</details>
{% endif %}

<h2>Checklist items</h2>
{% if not items %}
<p class="empty">No item ever started.</p>
{% endif %}
{% for agent in items %}
{{ parts.agent(agent) }}
{% endfor %}

{% if judge %}
<h2>Judge</h2>
{% for agent in judge %}
{{ parts.agent(agent) }}
{% endfor %}
{% endif %}
{% endblock %}
