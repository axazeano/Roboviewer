{% extends "_layout.html.j2" %}
{% import "_finding.html.j2" as parts %}

{% block title %}Review {{ meta.branch }} → {{ meta.target }}{% endblock %}

{% block content %}
<h1>Review {{ meta.branch }} → {{ meta.target }}</h1>

<dl class="meta">
<dt>Run</dt><dd><code>{{ meta.run_id }}</code></dd>
<dt>Merge base</dt><dd><code>{{ meta.base_sha[:12] }}</code> · HEAD <code>{{ meta.head_sha[:12] }}</code></dd>
<dt>Model</dt><dd><code>{{ meta.model }}</code></dd>
<dt>Files changed</dt><dd>{{ stats.files_changed }} (+{{ stats.added }} / −{{ stats.removed }})</dd>
<dt>Tokens</dt><dd>{{ stats.total_tokens | thousands }}</dd>
{% if cache.prompt_tokens %}
<dt>From cache</dt>
{% if cache.state == "hit" %}
<dd>{{ cache.cached_tokens | thousands }} prompt tokens ({{ cache.hit_rate | percent }} of input)</dd>
{% elif cache.state == "unknown" %}
<dd>unknown — the provider reports no statistics (<code>usage.prompt_tokens_details</code> is empty).
That does not mean there is no cache: a provider may serve the shared prefix from cache silently.
Latency tells you — repeating the same prefix comes back noticeably faster than a cold one.</dd>
{% else %}
<dd>0 — the provider does report statistics, and there was not a single hit. So either
the prefix differs every time, or caching is off on the provider's side.</dd>
{% endif %}
{% endif %}
</dl>

{% if not findings %}
<p class="empty">No findings.</p>
{% else %}
<ul class="tally">
{% for row in stats.by_severity %}
<li>{{ SEVERITY_ICON[row.severity] }} {{ SEVERITY_LABEL[row.severity] }}: {{ row.count }}</li>
{% endfor %}
</ul>
{% endif %}

{% if judge_summary %}
<div class="judge">{{ judge_summary | markdown }}</div>
{% endif %}

{% if findings %}
<h2>Findings</h2>
{% for finding in findings %}
{{ parts.finding(finding) }}
{% endfor %}
{% endif %}

{% if rejected %}
<details>
<summary>Rejected by the judge ({{ rejected | length }})</summary>
<ul>
{% for finding in rejected %}
<li><code>{{ finding.location }}</code> {{ finding.title }} ({{ finding.verdict or "?" }}){{ " — " ~ finding.verdict_reason if finding.verdict_reason else "" }}</li>
{% endfor %}
</ul>
</details>
{% endif %}

<h2>Checklist items</h2>
<table>
<thead>
<tr><th>Item</th><th>Status</th><th>Findings</th><th>Turns</th><th>Tokens</th><th>Cached</th><th>Time</th></tr>
</thead>
<tbody>
{% for item in items %}
<tr>
<td>{{ item.title }}</td>
<td>{{ STATUS_ICON[item.status] }}</td>
<td class="num">{{ item.findings_count }}</td>
<td class="num">{{ item.turns }}</td>
<td class="num">{{ item.total_tokens | thousands }}</td>
<td class="num">{{ (item.cache.hit_rate | percent) if item.cache.state == "hit" else ("n/a" if item.cache.state == "unknown" else "0%") }}</td>
<td class="num">{{ item.duration_s | fixed }}s</td>
</tr>
{% endfor %}
</tbody>
</table>

{% if truncated_items %}
<h2>Cut off by the turn limit</h2>
<p>The turn limit made these agents submit; they did not stop on their own. Read
the conclusions below before reaching for <code>max_turns</code>: if one already
reads as finished, that agent was not short of turns — it just never landed, and
a bigger budget will only cost more.</p>
<ul>
{% for item in truncated_items %}
<li><strong>{{ item.title }}</strong> — stopped at turn {{ item.turns }}{% if item.summary %}: {{ item.summary }}{% else %} without a conclusion{% endif %}</li>
{% endfor %}
</ul>
{% endif %}

{% if failed_items %}
<h2>Failed items</h2>
<ul>
{% for item in failed_items %}
<li class="failed"><strong>{{ item.title }}</strong>: {{ item.error }}</li>
{% endfor %}
</ul>
{% endif %}

<h2>Changed files</h2>
<pre><code>{% for file in files %}
{{- "%-3s +%-5s -%-5s %s" | format(file.status, file.added, file.removed, file.file) }}
{% endfor %}</code></pre>
{% endblock %}
